# Phase 1 — Docker / Synology
# Keine Defaults. Werte erzeugen:
#   SESSION_SECRET : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   ADMIN_PASSWORD : mindestens 12 Zeichen, z. B. per Passwortmanager
#   POSTGRES_PASSWORD : ebenfalls zufaellig, mindestens 16 Zeichen
# `start.bat` erzeugt SESSION_SECRET, POSTGRES_PASSWORD und ADMIN_PASSWORD beim ersten Lauf.
# Ohne DATABASE_URL laeuft die App im Demo-Modus (In-Memory, keine Persistenz).
DATABASE_URL=postgresql://nfc:CHANGE_ME@localhost:5432/nfc
# DIRECT_URL nur fuer Migrationen. Lokal identisch mit DATABASE_URL.
DIRECT_URL=postgresql://nfc:CHANGE_ME@localhost:5432/nfc
SESSION_SECRET=
ADMIN_EMAIL=admin@club.local
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
SEED_DEMO=0
# DEMO_MODE=1 erzwingt den Demo-Modus auch mit gesetzter DATABASE_URL.
DEMO_MODE=0

# Phase 2 — Vercel + Supabase/Neon (gleiches Schema, kein Code-Change)
# DATABASE_URL = pooled (Supabase Port 6543, ?pgbouncer=true)
# DIRECT_URL   = direct (Supabase Port 5432)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# SESSION_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# SEED_DEMO=1
