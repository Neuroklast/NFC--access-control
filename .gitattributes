# Shell-Skripte immer mit LF auschecken - CRLF bricht sie auf NAS/Linux.
*.sh text eol=lf
# Windows-Skripte mit CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
# .env-Vorlage und Compose-YAML mit LF (CRLF wuerde Werte verfaelschen).
.env.example text eol=lf
*.yml text eol=lf

# Nicht in Source-Archives / Release-ZIPs (GitHub nutzt git archive).
.gitattributes export-ignore
AGENTS.md export-ignore
CLAUDE.md export-ignore
GEMINI.md export-ignore
docs/agent-docs export-ignore
